{
  "mode": "observe",
  "project": "picturas",
  "rabbit_api": "http://localhost:15672/api",
  "rabbit_vhost": "/",
  "timeout_s": 2,
  "interval_s": 1,
  "compose_file": "../picturas-27/docker-compose.yaml",
  "actuation_timeout_s": 30,
  "readiness_timeout_s": 60,
  "policy": {
    "max_total": 3,
    "scale_out_cooldown_s": 5,
    "scale_in_idle_s": 40,
    "scale_in_cooldown_s": 30,
    "pools": [
      {
        "name": "normal",
        "service": "video_tool",
        "queue": "video_queue",
        "minimum": 1,
        "maximum": 2
      },
      {
        "name": "heavy",
        "service": "video_heavy_tool",
        "queue": "video_heavy_queue",
        "minimum": 0,
        "maximum": 2
      }
    ]
  }
}
